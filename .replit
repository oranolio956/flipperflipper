# Replit configuration for Stitch Elite RAT System
# This file configures how Replit runs your project

# Language and runtime
language = "python3"
run = "bash start_replit.sh"

# Environment variables
[env]
STITCH_DEBUG = "true"
STITCH_ADMIN_USER = "admin"
STITCH_ADMIN_PASSWORD = "SuperSecurePass123!"
STITCH_REDIS_URL = "memory://"
FLASK_ENV = "development"
FLASK_DEBUG = "true"

# Nix packages for additional system dependencies
[nix]
channel = "stable-23_11"

# Hidden files (don't show in file tree)
hidden = [".env", "*.log", "*.db", "*.key", "*.pem", "*.crt"]

# Port configuration
[ports]
5000 = { localPort = 5000, externalPort = 80 }

# Git configuration
[git]
enableGitSync = true

# Unit tests
[unitTest]
language = "python3"