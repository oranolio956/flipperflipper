[Unit]
Description=Telegran Telegram Bot - Auto Welcome & Support
After=network.target
Documentation=https://github.com/your-repo/telegran

[Service]
Type=simple
User=YOUR_USERNAME
Group=YOUR_GROUP
WorkingDirectory=/path/to/telegran
Environment="PATH=/path/to/telegran/venv/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/path/to/telegran/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/path/to/telegran

[Install]
WantedBy=multi-user.target
