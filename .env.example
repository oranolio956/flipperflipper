# Oranolio RAT - Elite C2 Framework Environment Configuration
# Copy this file to .env and update the values

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=Oranolio RAT
APP_VERSION=1.1.0
DEBUG=false
FLASK_ENV=production

# ============================================================================
# Server Configuration
# ============================================================================
STITCH_HOST=0.0.0.0
STITCH_PORT=5000
STITCH_DEBUG=false
STITCH_SERVER_PORT=4040
C2_HOST=0.0.0.0
C2_PORT=4447

# ============================================================================
# Security Settings
# ============================================================================
SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_SECRET=your-jwt-secret-here-change-this-in-production
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
CSP_ENABLED=true
CSP_REPORT_ONLY=false
ENABLE_HTTPS=true

# ============================================================================
# Authentication Settings
# ============================================================================
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_TIMEOUT=3600

# ============================================================================
# Rate Limiting
# ============================================================================
COMMANDS_PER_MINUTE=60
EXECUTIONS_PER_MINUTE=30
API_POLLING_PER_HOUR=1000
DEFAULT_RATE_LIMIT_DAY=10000
DEFAULT_RATE_LIMIT_HOUR=1000

# ============================================================================
# Database Settings
# ============================================================================
DATABASE_URL=sqlite:///data/main.db
EMAIL_DB_PATH=data/email_auth.db
MFA_DB_PATH=data/mfa_auth.db
LOGS_DB_PATH=data/logs.db
SESSIONS_DB_PATH=data/sessions.db

# ============================================================================
# Email Configuration
# ============================================================================
FROM_EMAIL=your-email@example.com
FROM_NAME=Oranolio Security
USE_AUTOMATED_EMAIL=true
USE_FREE_EMAIL=false

# Email Service Settings (choose one)
# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# Mailjet
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key

# AWS SES
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ============================================================================
# SSL/TLS Configuration
# ============================================================================
SSL_CERT_PATH=certs/server.crt
SSL_KEY_PATH=certs/server.key
SSL_CA_CERT_PATH=certs/ca.crt
SSL_CA_KEY_PATH=certs/ca.key

# ============================================================================
# Proxy Configuration (if behind reverse proxy)
# ============================================================================
STITCH_BEHIND_PROXY=false
STITCH_PROXY_X_FOR=1
STITCH_PROXY_X_PROTO=1
STITCH_PROXY_X_HOST=1
STITCH_PROXY_X_PREFIX=0

# ============================================================================
# Redis Configuration (for session management)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
STITCH_REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
ERROR_LOG_FILE=logs/errors.log
SECURITY_LOG_FILE=logs/security.log

# ============================================================================
# File Upload Configuration
# ============================================================================
UPLOAD_FOLDER=uploads
DOWNLOAD_FOLDER=downloads
MAX_CONTENT_LENGTH=16777216  # 16MB

# ============================================================================
# Performance Settings
# ============================================================================
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT=300
COMMAND_TIMEOUT=30
MAX_COMMAND_HISTORY=1000
MAX_DEBUG_LOGS=10000

# ============================================================================
# Development Settings (set to false in production)
# ============================================================================
DEVELOPMENT_MODE=false
AUTO_RELOAD=false
DEBUG_TOOLBAR=false

# ============================================================================
# Monitoring and Metrics
# ============================================================================
ENABLE_METRICS=true
METRICS_RETENTION_DAYS=30
ENABLE_PERFORMANCE_MONITORING=true

# ============================================================================
# Security Headers
# ============================================================================
ENABLE_SECURITY_HEADERS=true
HSTS_MAX_AGE=31536000
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# ============================================================================
# API Configuration
# ============================================================================
API_RATE_LIMIT=1000
API_RATE_WINDOW=3600
ENABLE_API_DOCS=true

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=24
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=backups

# ============================================================================
# Notification Settings
# ============================================================================
ENABLE_NOTIFICATIONS=true
NOTIFICATION_EMAIL=admin@example.com
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ============================================================================
# Advanced Settings
# ============================================================================
ENABLE_ELITE_COMMANDS=true
ENABLE_MEMORY_PROTECTION=true
ENABLE_EVASION_TECHNIQUES=true
ENABLE_CRYPTO_SYSTEM=true
ENABLE_NATIVE_PAYLOADS=true

# ============================================================================
# Custom Settings
# ============================================================================
# Add any custom environment variables here
# CUSTOM_SETTING=value